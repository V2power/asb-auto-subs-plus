{
  "manifest_version": 3,
  "name": "ASB Auto Subs",
  "description": "An extension to automatically download the subtitle file of the currently played anime intended to be used with ASB Player to add the downloaded subtitles to the video.",
  "version": "0.0.46",
  "icons": {
    "16": "imgs/logo.png",
    "32": "imgs/logo.png",
    "48": "imgs/logo.png",
    "128": "imgs/logo.png"
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "permissions": [
    "scripting",
    "downloads",
    "storage",
    "webNavigation",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://hianime.to/*",
    "https://hianimez.to/*",
    "https://miruro.tv/*",
    "https://www.miruro.tv/*",
    "https://miruro.online/*",
    "https://www.miruro.online/*",
    "https://miruro.to/*",
    "https://www.miruro.to/*",
    "https://jimaku.cc/*",
    "https://graphql.anilist.co/*",
    "http://127.0.0.1:8766/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://jimaku.cc https://graphql.anilist.co http://127.0.0.1:8766"
  },
  "action": {
    "default_popup": "html/popup.html",
    "default_icon": {
      "16": "imgs/logo.png",
      "32": "imgs/logo.png",
      "48": "imgs/logo.png",
      "128": "imgs/logo.png"
    }
  },
  "web_accessible_resources": []
}
