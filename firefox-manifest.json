{
  "manifest_version": 3,
  "name": "ASB Auto Subs",
  "description": "An extension to automatically download the subtitle file of the currently played anime intended to be used with ASB Player to add the downloaded subtitles to the video.",
  "version": "0.0.38",
  "background": {
    "scripts": ["dist/background.js"]
  },
  "permissions": [
    "scripting",
    "downloads",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "https://hianime.to/*",
    "https://miruro.tv/*",
    "https://miruro.online/*",
    "https://miruro.to/*",
    "https://jimaku.cc/*",
    "https://graphql.anilist.co/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://jimaku.cc https://graphql.anilist.co"
  },
  "action": {
    "default_popup": "html/popup.html",
    "default_icon": "imgs/logo.png"
  },
  "web_accessible_resources": [],
  "browser_specific_settings": {
    "gecko": {
      "id": "asbautosubs@godpepe7.com",
      "strict_min_version": "109.0"
    },
    "gecko_android": {
      "id": "asbautosubs@godpepe7.com",
      "strict_min_version": "109.0"
    }
  }
}
